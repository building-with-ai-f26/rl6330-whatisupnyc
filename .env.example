# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

# Supabase Postgres (secret). Use the Session pooler connection string from the
# project's Connect button, with the database password filled in. Dev project locally, production on the server.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
OPENROUTER_MODEL=replace-with-a-free-model-id
TICKETMASTER_API_KEY=replace-with-your-key
TAVILY_API_KEY=replace-with-your-key

# National Park Service events (optional; free key from https://www.nps.gov/subjects/developer/get-started.htm).
# Leave it empty to skip National Park Service events.
NPS_API_KEY=

# NYC Events Calendar (optional; free subscription key from the NYC API Portal, https://api-portal.nyc.gov).
# Leave it empty to skip NYC Events Calendar events.
NYC_EVENTS_CALENDAR_API_KEY=

# Paid backup model (optional), tried when the free OpenRouter model is busy or fails.
# Leave MINIMAX_API_KEY empty to run without a backup.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3

# Password for every page, 16 or more characters. The site stays closed without it.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
SITE_PASSWORD=replace-with-a-long-random-password

# PostHog analytics (optional). The project key starts with phc_ and is meant to be public.
# Leave POSTHOG_KEY empty to turn analytics off. Use https://eu.i.posthog.com for the EU region.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
