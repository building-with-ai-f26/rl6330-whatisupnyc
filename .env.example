# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key
OPENROUTER_MODEL=replace-with-a-free-model-id
TICKETMASTER_API_KEY=replace-with-your-key
TAVILY_API_KEY=replace-with-your-key

# Paid backup model (optional), tried when the free OpenRouter model is busy or fails.
# Leave MINIMAX_API_KEY empty to run without a backup.
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M3

# Password for every page, 16 or more characters. The site stays closed without it.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
SITE_PASSWORD=replace-with-a-long-random-password

# PostHog analytics (optional). The project key starts with phc_ and is meant to be public.
# Leave POSTHOG_KEY empty to turn analytics off. Use https://eu.i.posthog.com for the EU region.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
